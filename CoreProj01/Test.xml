<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="
http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">
<!-- Configure Our Bean classes Here -->
<bean id="std" class="com.nt.student.Student">
<property name="id" value="123"></property>
<property name="name" value="dilip"></property>
<property name="marks" value="8887"></property>
</bean>

<bean id="area" class="com.nt.student.Student.AreaDetails">
<property name="areaName" value="ameerpet"></property>
<property name="pin" value="504299"></property>
<property name="student" ref="std"></property>
</bean>
</beans>